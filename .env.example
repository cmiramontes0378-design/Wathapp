# Clave de la API de Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Tu nombre EXACTAMENTE como aparece en los chats exportados (ej. "Carlos Miramontes").
# Si lo dejas vacío, se adivina (el autor que aparece en todos los chats).
MI_NOMBRE=

# Modelo de Claude
MODELO=claude-opus-5

# borrador = te manda la respuesta propuesta a tu chat "Tú" y tú la apruebas con "si N"
# auto     = contesta solo, sin pedir permiso
MODO=borrador

# Segundos que espera tras el último mensaje antes de contestar (por si te mandan varios seguidos)
RETRASO_SEGUNDOS=25

# ¿Contestar también en grupos? (true/false)
RESPONDER_GRUPOS=false

# Listas separadas por comas (nombres de contacto o números con código de país, ej. 5215512345678).
# Si CONTACTOS_PERMITIDOS tiene algo, SOLO se contesta a esos.
CONTACTOS_PERMITIDOS=
CONTACTOS_BLOQUEADOS=

# Horario en que el bot contesta (24h). 0-24 = todo el día.
HORA_INICIO=0
HORA_FIN=24

# Cuántos contactos (los que más hablas) estudiar a fondo para tomar notas de la relación
ESTUDIAR_CONTACTOS=20
